{
  "name": "object-detective",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "A donation arrives with a questionable label. Examine museum objects under raking light, measure and compare them, corroborate with archival records, and write a corrected museum label that states what you know and how sure you are.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-attribution.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:subpath": "npm run build && playwright test tests/sub-path.spec.js",
    "check:a11y": "playwright test tests/a11y.spec.js",
    "check:content": "node scripts/check-content.mjs",
    "check:v3-assets": "node scripts/check-v3-assets.mjs",
    "poster": "node scripts/render-poster.mjs",
    "attribution": "node scripts/gen-attribution.mjs",
    "make:lut": "node scripts/make-lut.mjs"
  },
  "dependencies": {
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "meshoptimizer": "1.3.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
