# Dependencies
node_modules/

# Build output
dist/
tmp/

# Generated at build time from content/ (scripts/sync-content.mjs)
public/content/

# Decoders are copied from the pinned three package by vite-plugin-decoders.js
public/decoders/

# Security-hook state (local only)
.mimosa/

# Raw source data (never committed; scripts download it)
data/raw/

# Test output, screenshots, recordings
test-results/
playwright-report/
*.webm
!docs/trailer.webm

# Environment and secrets — never commit
.env
.env.*

# macOS
.DS_Store

# Vercel (showcase repo) — never commit
.vercel/

# Editor
*.swp
.idea/
.vscode/
